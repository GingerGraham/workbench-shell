aliases=get-functions
bashconfig=${VISUAL:-vim} "${HOME}/.bashrc"
bashreload=exec bash
bashsource=source "${HOME}/.bashrc"
bat=batcat
battery=acpi -bi
black=it2profile -s Black
cat=batcat -p
clip=wl-copy
cls=clear
code=code-insiders
copy=wl-copy
dirsize=du -sh
explorer=nautilus --browser &
installers=wb tools list
lsa=command ls --color=auto -Alhi
lsr=command ls --color=auto -Alhitr
matrix=cmatrix -abs
nordc=nordvpn connect
nordd=nordvpn disconnect
pip=pip3
power=acpi -a
printrt=ip route
python=python3
reset-shell=clear && get-functions --no-pager --no-aliases
routeprint=ip route
rs=clear && get-functions --no-pager --no-aliases
smooth=it2profile -s Smooth
solarized=it2profile -s Solarized
sshclear=ssh-add -D
sshhosts=grep -E "^Host\s" "${HOME}/.ssh/config"
tmux-attach=tmux attach-session -t main
tmux-new=tmux new-session -s main
top=btop
